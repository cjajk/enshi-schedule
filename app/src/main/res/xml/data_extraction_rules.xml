<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 数据提取规则：云端备份与设备迁移均排除存有密码的 DataStore 文件 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
